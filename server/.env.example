# Magento 2 GraphQL — products are loaded from Magento DB (not mock)
MAGENTO_URL=http://m248p4.local
MAGENTO_GRAPHQL_URL=http://m248p4.local/graphql
MAGENTO_STORE_CODE=default
MAGENTO_ACCESS_TOKEN=
MAGENTO_GRAPHQL_USE_AUTH=false
MAGENTO_PAGE_SIZE=0
MAGENTO_TIMEOUT_MS=20000

# Ollama
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Local models can take 30–90s on CPU; raise if you still see timeouts
OLLAMA_TIMEOUT_MS=120000
PORT=3001

# PostgreSQL + pgvector (product semantic + user context memory)
SEMANTIC_ENABLED=true
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ai_commerce_assistant
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMS=1024
SEMANTIC_TOP_K=12
SEMANTIC_MIN_SCORE=0.35
SEMANTIC_FALLBACK_MIN_SCORE=0.55

# User context memory (conversation / preference reuse)
CONTEXT_MEMORY_ENABLED=true
CONTEXT_SIMILARITY_THRESHOLD=0.80

# Merchant vertical (domains, clarify chips, attribute maps, LLM catalog hint)
# Default: server/domain-config.json — copy domain-config.example-auto.json for a non-apparel demo
# DOMAIN_CONFIG_PATH=./domain-config.json

# Analytics (zero-result, hybrid lift, CTR) uses the same DATABASE_URL.
# Run: npm run db:migrate:analytics
# UI: http://localhost:5173/analytics
# Magento Admin: magento/Klizer/AiCommerceAnalytics
