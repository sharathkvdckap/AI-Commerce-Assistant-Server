# Magento 2 GraphQL — products are loaded from Magento DB (not mock)
MAGENTO_URL=http://m248p4.local
MAGENTO_GRAPHQL_URL=http://m248p4.local/graphql
MAGENTO_STORE_CODE=default
MAGENTO_ACCESS_TOKEN=
MAGENTO_GRAPHQL_USE_AUTH=false
MAGENTO_PAGE_SIZE=0
MAGENTO_TIMEOUT_MS=20000

# Chat LLM: ollama (local) | groq (cloud free-tier)
LLM_PROVIDER=ollama

# Ollama (LLM_PROVIDER=ollama)
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_MS=45000

# Groq free-tier (LLM_PROVIDER=groq) — https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
PORT=3001

# Phase 4 — PostgreSQL + pgvector semantic search
SEMANTIC_ENABLED=true
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ai_commerce_assistant
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMS=1024
SEMANTIC_TOP_K=12
SEMANTIC_MIN_SCORE=0.35
SEMANTIC_FALLBACK_MIN_SCORE=0.55

# Merchant vertical config (optional; default server/domain-config.json)
# DOMAIN_CONFIG_PATH=./domain-config.json
